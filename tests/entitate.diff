+package ro.mycode.user_management.users.controllers;
+
+import org.springframework.web.bind.annotation.*;
+import ro.mycode.user_management.users.models.User;
+import ro.mycode.user_management.users.repository.UserRepository;
+
+import java.util.List;
+
+@RestController
+@RequestMapping("/api/v1/export")
+public class ExportController {
+
+    private final UserRepository userRepository;
+
+    public ExportController(UserRepository userRepository) {
+        this.userRepository = userRepository;
+    }
+
+    @GetMapping("/users")
+    public List<User> users() {
+        return userRepository.findAll();
+    }
+}
